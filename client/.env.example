# BINGO Frontend Environment Variables
# ------------------------------------
# For Render Deployment (Frontend Static Site):
# Set this in the Render Dashboard under Environment Variables:
# VITE_SERVER_URL=https://zyraforge-bingo-api.onrender.com
# (or your custom Render backend web service URL)

# For Local Development:
# Leave blank to use Vite dev proxy, or set to your local backend server port:
# VITE_SERVER_URL=http://localhost:3001
VITE_SERVER_URL=
